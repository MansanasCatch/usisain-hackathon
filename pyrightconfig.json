{
  "include": [
    "backend-api",
    "mcp_server",
    "desktop"
  ],
  "exclude": [
    "desktop/dist",
    "desktop/build",
    "venv",
    ".agents"
  ],
  "extraPaths": [
    "backend-api/src",
    "mcp_server",
    "desktop",
    "."
  ],
  "executionEnvironments": [
    {
      "root": "backend-api/src",
      "extraPaths": [
        "backend-api/src",
        "mcp_server",
        "."
      ]
    },
    {
      "root": "mcp_server",
      "extraPaths": [
        "mcp_server",
        "backend-api/src",
        "."
      ]
    }
  ],
  "venvPath": ".",
  "venv": "venv"
}
