# Copy this file to .env (project root) and fill in real values.
# See README section 3 for exactly where to get each key.

# ---------------- LLM ----------------
# Use 'gemini' for fast cloud-based reasoning, or 'ollama' for fully local offline reasoning.
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LANGUAGE=english

# If using 'ollama', ensure the Ollama app is running locally and the model is pulled.
# Text-only model (used when no image is involved)
OLLAMA_MODEL=llama3.2:1b
# Vision model (used when analyzing images or image+text)
OLLAMA_VISION_MODEL=moondream
OLLAMA_HOST=http://localhost:11434

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---------------- Step 3: search ----------------
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
STEP3_FAST_QUERY_GEN=True
STEP3_FETCH_FULL_PAGE=False

# ---------------- Step 2: video ----------------
MAX_VIDEO_FRAMES=24

# ---------------- Text-to-speech ----------------
# Set to True to enable offline speech synthesis, or False (default) to disable it.
TTS_ENABLED=False

# Pipeline timeout for each step in seconds. Change once in .env.
PIPELINE_STEP_TIMEOUT_SECONDS=200.0

# ---------------- Messenger bot ----------------
META_VERIFY_TOKEN=choose_any_random_string_yourself
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
BACKEND_URL=http://localhost:8000
