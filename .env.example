# Copy this file to .env (project root) and fill in real values.
# See README for details on configuration.

# ---------------- LLM Providers ----------------
# Ollama is the default offline provider.
# 'gemini' and 'grok' are optional cloud alternatives with automatic Ollama fallback.
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LANGUAGE=english

# --- Local Ollama (Default) ---
# Ensure Ollama is running locally (e.g. `ollama serve`) and models are pulled.
OLLAMA_MODEL=llama3.2:1b
OLLAMA_VISION_MODEL=moondream
OLLAMA_HOST=http://localhost:11434
OLLAMA_CLIENT_TIMEOUT=200

# --- Google Gemini (Optional Cloud Alternative) ---
# Free API key at https://aistudio.google.com/apikey (supports comma-separated keys for rotation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_RPM_LIMIT=15

# --- xAI Grok (Optional Cloud Alternative) ---
# API key at https://console.x.ai/ (supports comma-separated keys for rotation)
GROK_API_KEY=
GROK_MODEL=gpt-oss-120b

# ---------------- Step 3: Search & Fact-Checking ----------------
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
STEP3_FAST_QUERY_GEN=True
STEP3_FETCH_FULL_PAGE=False

# ---------------- Step 2: Video Forensics ----------------
MAX_VIDEO_FRAMES=24

# ---------------- Text-to-speech ----------------
TTS_ENABLED=False

# ---------------- OCR (Optional) ----------------
# Tesseract OCR is completely optional. If uninstalled or False, multimodal vision models are used instead.
TESSERACT_ENABLED=True

# Pipeline timeout for each step in seconds
PIPELINE_STEP_TIMEOUT_SECONDS=200.0

# ---------------- Upload restrictions ----------------
# Maximum upload size for reference documents in MB (default 10 MB)
MAX_REFERENCE_DOC_SIZE_MB=10.0
