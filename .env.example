# Copy this file to .env (project root) and fill in real values.
# See README section 3 for exactly where to get each key.

# ---------------- LLM ----------------
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LANGUAGE=taglish

OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---------------- Step 3: search ----------------
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# ---------------- Step 2: video ----------------
MAX_VIDEO_FRAMES=24

# ---------------- Text-to-speech ----------------
# Set to True to enable offline speech synthesis, or False (default) to disable it.
TTS_ENABLED=False

# Pipeline timeout for each step in seconds. Change once in .env.
PIPELINE_STEP_TIMEOUT_SECONDS=180.0

# ---------------- Messenger bot ----------------
META_VERIFY_TOKEN=choose_any_random_string_yourself
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
BACKEND_URL=http://localhost:8000
